  "retry": { "max": 2, "baseMs": 600, "maxMs": 5000 },
  "cors": { "allowOrigins": [] },

  "//access": "访问控制：主密钥策略 / 来源 IP 白名单 / 审计。受限密钥请在控制台「访问控制」页或用 data/keys.json 管理。",
  "access": {
    "master": {
      "name": "主密钥",
      "rpm": 0,
      "concurrency": 0,
      "dailyCalls": 0,
      "dailyCredit": 0
    },
    "ipAllowList": [],
    "audit": {
      "enabled": true,
      "maxEntries": 2000,
      "includeBody": false
    }
  },

  "//metrics": "监控：/metrics（Prometheus 文本格式）与内存中保留的最近请求条数。",
