# 运行时数据统一放在 data/（凭证、配置、统计、审计、日志），整目录忽略
data/

# 兼容旧布局（v1.2 之前散落在根目录，首次启动会自动迁移进 data/）
auth.json
auth.*.json
config.json
usage.json
checkin.json
checkin.log
.login-state.json
.gh-token
# DeepSeek 官方站点凭证（token 明文，切勿提交）
.ds-token
auth.deepseek.json
node_modules/
*.log
_ref/

# 与本项目无关的其他目录（各自独立，不与本仓库混合提交）
zcode-proxy/

# AI 工具元数据与工作记忆
.codebuddy/

# Windows 文件权限诊断产物（非项目文件）
.dsh-acl-recovery/